{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "agent": "architect",
  "permissions": {
    "allow": ["Bash", "Edit", "Write", "WebFetch"]
  },
  "enableAllProjectMcpServers": true,
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [{ "type": "command", "command": "node .claude/hooks/checks.mjs" }]
      }
    ]
  }
}
