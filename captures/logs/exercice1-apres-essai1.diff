 export const roomsRouter = Router();
 
@@ -15,3 +16,18 @@ roomsRouter.get("/:id", (req, res) => {
   }
   res.json({ room, bookings: bookingsForRoom(room.id) });
 });
+
+roomsRouter.get("/:id/availability", (req, res) => {
+  const room = findRoom(req.params.id);
+  if (!room) {
+    res.status(404).json({ error: "salle inconnue" });
+    return;
+  }
+  const date = typeof req.query.date === "string" ? req.query.date : "";
+  const result = freeSlots(date, bookingsForRoom(room.id));
+  if (!result.ok) {
+    res.status(400).json({ error: result.error });
+    return;
+  }
+  res.json({ roomId: room.id, date, slots: result.value });
+});
