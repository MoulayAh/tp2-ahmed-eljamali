+import type { Result } from "./result.js";
+
+export type Slot = { start: string; end: string };
+
+const DAY_MS = 24 * 60 * 60 * 1000;
+
+/**
+ * Creneaux libres d'une salle pour un jour UTC (YYYY-MM-DD), en ISO 8601 Z.
+ */
+export function freeSlots(
+  date: string,
+  bookings: ReadonlyArray<{ startsAt: string; endsAt: string }>
+): Result<Slot[], string> {
+  if (!/^\d{4}-\d{2}-\d{2}$/.test(date)) {
+    return { ok: false, error: "date invalide : format attendu AAAA-MM-JJ" };
+  }
+  const dayStart = Date.parse(`${date}T00:00:00Z`);
+  if (Number.isNaN(dayStart) || new Date(dayStart).toISOString().slice(0, 10) !== date) {
+    return { ok: false, error: "date invalide : jour inexistant au calendrier" };
+  }
+  const dayEnd = dayStart + DAY_MS;
+
+  const busy = bookings
+    .map((b) => ({
+      start: Math.max(Date.parse(b.startsAt), dayStart),
+      end: Math.min(Date.parse(b.endsAt), dayEnd),
+    }))
+    .filter((b) => b.start < b.end)
+    .sort((a, b) => a.start - b.start);
+
+  const slots: Slot[] = [];
+  let cursor = dayStart;
+  for (const b of busy) {
+    if (b.start > cursor) {
+      slots.push({ start: new Date(cursor).toISOString(), end: new Date(b.start).toISOString() });
+    }
+    cursor = Math.max(cursor, b.end);
+  }
+  if (cursor < dayEnd) {
+    slots.push({ start: new Date(cursor).toISOString(), end: new Date(dayEnd).toISOString() });
+  }
+  return { ok: true, value: slots };
+}
