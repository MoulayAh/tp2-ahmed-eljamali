+import { describe, it, expect } from "vitest";
+import { createApp } from "../src/app.js";
+
+async function call(path: string, init?: RequestInit) {
+  const app = createApp();
+  const server = app.listen(0);
+  const { port } = server.address() as { port: number };
+  try {
+    const res = await fetch(`http://127.0.0.1:${port}${path}`, init);
+    return { status: res.status, body: (await res.json()) as any };
+  } finally {
+    server.close();
+  }
+}
+
+describe("GET /rooms/:id/availability", () => {
+  it("renvoie la journee entiere pour une salle sans reservation", async () => {
+    const res = await call("/rooms/labo/availability?date=2031-03-04");
+    expect(res.status).toBe(200);
+    expect(res.body).toEqual({
+      roomId: "labo",
+      date: "2031-03-04",
+      slots: [{ start: "2031-03-04T00:00:00.000Z", end: "2031-03-05T00:00:00.000Z" }]
+    });
+  });
+
+  it("retire une reservation creee via POST /bookings", async () => {
+    const created = await call("/bookings", {
+      method: "POST",
+      headers: { "content-type": "application/json" },
+      body: JSON.stringify({
+        roomId: "salle-b",
+        who: "test",
+        people: 2,
+        startsAt: "2031-06-10T10:00:00Z",
+        endsAt: "2031-06-10T12:00:00Z"
+      })
+    });
+    expect(created.status).toBe(201);
+
+    const res = await call("/rooms/salle-b/availability?date=2031-06-10");
+    expect(res.status).toBe(200);
+    expect(res.body.slots).toEqual([
+      { start: "2031-06-10T00:00:00.000Z", end: "2031-06-10T10:00:00.000Z" },
+      { start: "2031-06-10T12:00:00.000Z", end: "2031-06-11T00:00:00.000Z" }
+    ]);
+  });
+
+  it("retire la reservation du jeu de donnees initial", async () => {
+    const res = await call("/rooms/salle-a/availability?date=2026-10-05");
+    expect(res.status).toBe(200);
+    expect(res.body.slots).toEqual([
+      { start: "2026-10-05T00:00:00.000Z", end: "2026-10-05T09:00:00.000Z" },
+      { start: "2026-10-05T11:00:00.000Z", end: "2026-10-06T00:00:00.000Z" }
+    ]);
+  });
+
+  it("renvoie 404 pour une salle inconnue", async () => {
+    const res = await call("/rooms/cave/availability?date=2031-03-04");
+    expect(res.status).toBe(404);
+    expect(res.body).toEqual({ error: "salle inconnue" });
+  });
+
+  it("renvoie 404 avant 400 pour une salle inconnue sans date", async () => {
+    const res = await call("/rooms/cave/availability");
+    expect(res.status).toBe(404);
+    expect(res.body).toEqual({ error: "salle inconnue" });
+  });
+
+  it("renvoie 400 si date est absente", async () => {
+    const res = await call("/rooms/labo/availability");
+    expect(res.status).toBe(400);
+    expect(typeof res.body.error).toBe("string");
+  });
+
+  it.each(["2026-02-30", "2026-03-04T10:00:00Z", "garbage"])(
+    "renvoie 400 pour date=%s",
+    async (date) => {
+      const res = await call(`/rooms/labo/availability?date=${date}`);
+      expect(res.status).toBe(400);
+      expect(typeof res.body.error).toBe("string");
+    }
+  );
+
+  it("renvoie 400 pour un parametre date repete", async () => {
+    const res = await call("/rooms/labo/availability?date=2026-03-04&date=2026-03-05");
+    expect(res.status).toBe(400);
+    expect(typeof res.body.error).toBe("string");
+  });
+
+  it("GET /rooms/:id repond toujours 200", async () => {
+    const res = await call("/rooms/labo");
+    expect(res.status).toBe(200);
+    expect(res.body.room.id).toBe("labo");
+  });
+});
