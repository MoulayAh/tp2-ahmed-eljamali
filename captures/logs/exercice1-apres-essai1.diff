+import { describe, it, expect } from "vitest";
+import { freeSlots } from "../src/lib/availability.js";
+
+const DAY = "2026-03-04";
+const START = "2026-03-04T00:00:00.000Z";
+const END = "2026-03-05T00:00:00.000Z";
+
+function slotsOf(date: string, bookings: { startsAt: string; endsAt: string }[]) {
+  const res = freeSlots(date, bookings);
+  if (!res.ok) throw new Error(res.error);
+  return res.value;
+}
+
+describe("freeSlots", () => {
+  it("sans reservation, renvoie la journee entiere", () => {
+    expect(slotsOf(DAY, [])).toEqual([{ start: START, end: END }]);
+  });
+
+  it("une reservation au milieu laisse deux creneaux", () => {
+    const slots = slotsOf(DAY, [
+      { startsAt: "2026-03-04T10:00:00Z", endsAt: "2026-03-04T12:00:00Z" },
+    ]);
+    expect(slots).toEqual([
+      { start: START, end: "2026-03-04T10:00:00.000Z" },
+      { start: "2026-03-04T12:00:00.000Z", end: END },
+    ]);
+  });
+
+  it("une reservation qui commence a 00:00Z n'a pas de creneau avant", () => {
+    const slots = slotsOf(DAY, [
+      { startsAt: "2026-03-04T00:00:00Z", endsAt: "2026-03-04T08:00:00Z" },
+    ]);
+    expect(slots).toEqual([{ start: "2026-03-04T08:00:00.000Z", end: END }]);
+  });
+
+  it("une reservation qui finit a 24:00Z n'a pas de creneau apres", () => {
+    const slots = slotsOf(DAY, [
+      { startsAt: "2026-03-04T20:00:00Z", endsAt: "2026-03-05T00:00:00Z" },
+    ]);
+    expect(slots).toEqual([{ start: START, end: "2026-03-04T20:00:00.000Z" }]);
+  });
+
+  it("fusionne deux reservations adjacentes", () => {
+    const slots = slotsOf(DAY, [
+      { startsAt: "2026-03-04T09:00:00Z", endsAt: "2026-03-04T10:00:00Z" },
+      { startsAt: "2026-03-04T10:00:00Z", endsAt: "2026-03-04T11:00:00Z" },
+    ]);
+    expect(slots).toEqual([
+      { start: START, end: "2026-03-04T09:00:00.000Z" },
+      { start: "2026-03-04T11:00:00.000Z", end: END },
+    ]);
+  });
+
+  it("fusionne deux reservations qui se chevauchent", () => {
+    const slots = slotsOf(DAY, [
+      { startsAt: "2026-03-04T09:00:00Z", endsAt: "2026-03-04T11:00:00Z" },
+      { startsAt: "2026-03-04T10:00:00Z", endsAt: "2026-03-04T12:00:00Z" },
+    ]);
+    expect(slots).toEqual([
+      { start: START, end: "2026-03-04T09:00:00.000Z" },
+      { start: "2026-03-04T12:00:00.000Z", end: END },
+    ]);
+  });
+
+  it("trie la sortie meme si l'entree est en desordre", () => {
+    const slots = slotsOf(DAY, [
+      { startsAt: "2026-03-04T15:00:00Z", endsAt: "2026-03-04T16:00:00Z" },
+      { startsAt: "2026-03-04T09:00:00Z", endsAt: "2026-03-04T10:00:00Z" },
+    ]);
+    expect(slots).toEqual([
+      { start: START, end: "2026-03-04T09:00:00.000Z" },
+      { start: "2026-03-04T10:00:00.000Z", end: "2026-03-04T15:00:00.000Z" },
+      { start: "2026-03-04T16:00:00.000Z", end: END },
+    ]);
+  });
+
+  it("rogne une reservation commencee la veille", () => {
