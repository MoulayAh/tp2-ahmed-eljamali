+      { start: "2026-03-04T10:00:00.000Z", end: END },
+    ]);
+  });
+
+  it.each(["", "2026-02-30", "2026-13-01", "2026-3-4", "2026-03-04T00:00:00Z", "2026-03-04x", "abc"])(
+    "refuse la date invalide %j",
+    (date) => {
+      const res = freeSlots(date, []);
+      expect(res.ok).toBe(false);
+    }
+  );
+
+  it("accepte le 29 fevrier d'une annee bissextile et refuse les autres", () => {
+    expect(freeSlots("2028-02-29", []).ok).toBe(true);
+    expect(freeSlots("2027-02-29", []).ok).toBe(false);
+  });
+
+  it("passe d'une annee a l'autre", () => {
+    expect(slotsOf("2026-12-31", [])).toEqual([
+      { start: "2026-12-31T00:00:00.000Z", end: "2027-01-01T00:00:00.000Z" },
+    ]);
+  });
+});
