--- /dev/null
+++ b/src/lib/availability.ts
@@ -0,0 +1,59 @@
+export type Result<T> = { ok: true; value: T } | { ok: false; error: string };
+
+export interface Slot {
+  startsAt: string;
+  endsAt: string;
+}
+
+export const OPEN_HOUR = 8;
+export const CLOSE_HOUR = 20;
+
+const HOUR_MS = 3600000;
+
+/** Valide le parametre de date et renvoie le jour normalise au format YYYY-MM-DD. */
+export function parseDay(date: unknown): Result<string> {
+  if (typeof date !== "string" || !/^\d{4}-\d{2}-\d{2}$/.test(date)) {
+    return { ok: false, error: "date invalide, format attendu YYYY-MM-DD" };
+  }
+  const parsed = new Date(`${date}T00:00:00.000Z`);
+  if (Number.isNaN(parsed.getTime()) || parsed.toISOString().slice(0, 10) !== date) {
+    return { ok: false, error: "date inexistante" };
+  }
+  return { ok: true, value: date };
+}
+
+/** Calcule les creneaux libres d'un jour UTC entre les heures d'ouverture, a partir des reservations. */
+export function freeSlots(date: string, booked: Slot[]): Slot[] {
+  const dayStart = Date.parse(`${date}T00:00:00.000Z`);
+  const open = dayStart + OPEN_HOUR * HOUR_MS;
+  const close = dayStart + CLOSE_HOUR * HOUR_MS;
+
+  const intervals = booked
+    .map((b) => ({
+      start: Math.max(Date.parse(b.startsAt), open),
+      end: Math.min(Date.parse(b.endsAt), close)
+    }))
+    .filter((i) => i.start < i.end)
+    .sort((a, b) => a.start - b.start);
+
+  const free: Slot[] = [];
+  let cursor = open;
+  for (const i of intervals) {
+    if (i.start > cursor) {
+      free.push({
+        startsAt: new Date(cursor).toISOString(),
+        endsAt: new Date(i.start).toISOString()
+      });
+    }
+    cursor = Math.max(cursor, i.end);
+  }
+  if (cursor < close) {
+    free.push({
+      startsAt: new Date(cursor).toISOString(),
+      endsAt: new Date(close).toISOString()
+    });
+  }
+  return free;
+}
+
+export default freeSlots;
diff --git a/src/routes/rooms.ts b/src/routes/rooms.ts
index 7b502b6..24622d8 100644
--- a/src/routes/rooms.ts
+++ b/src/routes/rooms.ts
@@ -1,5 +1,6 @@
 import { Router } from "express";
 import { rooms, findRoom, bookingsForRoom } from "../store.js";
+import { CLOSE_HOUR, OPEN_HOUR, freeSlots, parseDay } from "../lib/availability.js";
 
 export const roomsRouter = Router();
 
@@ -15,3 +16,24 @@ roomsRouter.get("/:id", (req, res) => {
   }
   res.json({ room, bookings: bookingsForRoom(room.id) });
 });
+
+roomsRouter.get("/:id/availability", (req, res) => {
+  const room = findRoom(req.params.id);
+  if (!room) {
+    res.status(404).json({ error: "salle inconnue" });
+    return;
+  }
+  const day = parseDay(req.query.date);
+  if ("error" in day) {
+    res.status(400).json({ error: day.error });
+    return;
+  }
+  const date = day.value;
+  res.json({
+    roomId: room.id,
+    date,
+    open: `${date}T${String(OPEN_HOUR).padStart(2, "0")}:00:00.000Z`,
+    close: `${date}T${String(CLOSE_HOUR).padStart(2, "0")}:00:00.000Z`,
+    free: freeSlots(date, bookingsForRoom(room.id))
+  });
+});
diff --git a/test/availability.route.spec.ts b/test/availability.route.spec.ts
