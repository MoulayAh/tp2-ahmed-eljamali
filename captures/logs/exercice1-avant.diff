@@ -0,0 +1,55 @@
+import { describe, it, expect } from "vitest";
+import { createApp } from "../src/app.js";
+
+async function call(path: string, init?: RequestInit) {
+  const app = createApp();
+  const server = app.listen(0);
+  const { port } = server.address() as { port: number };
+  try {
+    const res = await fetch(`http://127.0.0.1:${port}${path}`, init);
+    return { status: res.status, body: await res.json() };
+  } finally {
+    server.close();
+  }
+}
+
+describe("GET /rooms/:id/availability", () => {
+  it("renvoie les creneaux libres autour de la reservation de salle-a", async () => {
+    const res = await call("/rooms/salle-a/availability?date=2026-10-05");
+    expect(res.status).toBe(200);
+    expect(res.body).toEqual({
+      roomId: "salle-a",
+      date: "2026-10-05",
+      open: "2026-10-05T08:00:00.000Z",
+      close: "2026-10-05T20:00:00.000Z",
+      free: [
+        { startsAt: "2026-10-05T08:00:00.000Z", endsAt: "2026-10-05T09:00:00.000Z" },
+        { startsAt: "2026-10-05T11:00:00.000Z", endsAt: "2026-10-05T20:00:00.000Z" }
+      ]
+    });
+  });
+
+  it("renvoie la journee complete pour une salle sans reservation", async () => {
+    const res = await call("/rooms/labo/availability?date=2026-10-05");
+    expect(res.status).toBe(200);
+    expect(res.body).toMatchObject({
+      free: [{ startsAt: "2026-10-05T08:00:00.000Z", endsAt: "2026-10-05T20:00:00.000Z" }]
+    });
+  });
+
+  it("refuse une salle inconnue", async () => {
+    const res = await call("/rooms/cave/availability?date=2026-10-05");
+    expect(res.status).toBe(404);
+    expect(res.body).toEqual({ error: "salle inconnue" });
+  });
+
+  it("refuse une date absente", async () => {
+    const res = await call("/rooms/salle-a/availability");
+    expect(res.status).toBe(400);
+  });
+
+  it("refuse une date qui n'existe pas au calendrier", async () => {
+    const res = await call("/rooms/salle-a/availability?date=2026-02-30");
+    expect(res.status).toBe(400);
+  });
+});
diff --git a/test/availability.spec.ts b/test/availability.spec.ts
new file mode 100644
index 0000000..9a39e77
--- /dev/null
+++ b/test/availability.spec.ts
@@ -0,0 +1,64 @@
+import { describe, it, expect } from "vitest";
+import { freeSlots, parseDay } from "../src/lib/availability.js";
+
+const DAY = "2026-10-05";
+const at = (hhmm: string, day = DAY) => `${day}T${hhmm}:00.000Z`;
+const slot = (from: string, to: string) => ({ startsAt: at(from), endsAt: at(to) });
+
+describe("freeSlots", () => {
+  it("renvoie un seul creneau 08-20 pour un jour vide", () => {
+    expect(freeSlots(DAY, [])).toEqual([slot("08:00", "20:00")]);
+  });
+
+  it("coupe en deux autour d'une reservation au milieu", () => {
+    expect(freeSlots(DAY, [slot("09:00", "11:00")])).toEqual([
+      slot("08:00", "09:00"),
+      slot("11:00", "20:00")
+    ]);
+  });
+
+  it("fusionne les reservations qui se touchent sans creneau de longueur nulle", () => {
+    expect(freeSlots(DAY, [slot("10:00", "11:00"), slot("09:00", "10:00")])).toEqual([
+      slot("08:00", "09:00"),
+      slot("11:00", "20:00")
+    ]);
+  });
+
+  it("gere les reservations collees a l'ouverture et a la fermeture", () => {
+    expect(freeSlots(DAY, [slot("08:00", "09:00"), slot("19:00", "20:00")])).toEqual([
+      slot("09:00", "19:00")
+    ]);
+  });
+
+  it("tronque une reservation qui chevauche minuit", () => {
+    const before = { startsAt: at("22:00", "2026-10-04"), endsAt: at("09:00") };
+    const after = { startsAt: at("18:00"), endsAt: at("04:00", "2026-10-06") };
+    expect(freeSlots(DAY, [before, after])).toEqual([slot("09:00", "18:00")]);
+  });
+
+  it("ignore une reservation d'un autre jour", () => {
+    const other = { startsAt: at("09:00", "2026-10-06"), endsAt: at("11:00", "2026-10-06") };
+    expect(freeSlots(DAY, [other])).toEqual([slot("08:00", "20:00")]);
+  });
+
+  it("renvoie une liste vide pour un jour complet", () => {
+    expect(freeSlots(DAY, [slot("07:00", "21:00")])).toEqual([]);
+  });
+
+  it("fusionne les reservations imbriquees", () => {
+    expect(freeSlots(DAY, [slot("09:00", "15:00"), slot("10:00", "11:00")])).toEqual([
+      slot("08:00", "09:00"),
+      slot("15:00", "20:00")
+    ]);
+  });
+});
+
+describe("parseDay", () => {
+  it("accepte une date valide", () => {
+    expect(parseDay("2026-10-05")).toEqual({ ok: true, value: "2026-10-05" });
+  });
+
+  it.each([undefined, "2026-1-5", "2026-02-30", "abc"])("refuse %s", (input) => {
+    expect(parseDay(input).ok).toBe(false);
+  });
+});
